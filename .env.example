# Create an API key in a Google project WITHOUT billing enabled.
GOOGLE_API_KEY=
# Set true only after verifying the project has no billing account.
FREE_TIER_CONFIRMED=false
# Process-local UTC daily cap; resets on restart. Provider quota is authoritative.
MAX_DAILY_CALLS=100

# Groq Free Plan key for GPT-OSS / Qwen models
GROQ_API_KEY=
